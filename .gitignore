# Godot's import cache
game/.godot/

# Build output (the extension and Steam Audio are copied into game/bin by the build)
audio_core/build/
audio_core/build-release/
game/bin/
# The double-clickable StudioSim, made by tools/export.sh
dist/

# Third-party downloads, fetched by tools/fetch_deps.sh
audio_core/thirdparty/steamaudio/
audio_core/thirdparty/miniaudio/
audio_core/thirdparty/vst3sdk/
audio_core/thirdparty/opus/
# Steinberg's ASIO SDK, downloaded by hand (see audio_core/CMakeLists.txt)
audio_core/thirdparty/asiosdk/

.DS_Store

# What StudioSim keeps for you when run from here (rooms, templates, instrument presets): yours, not the project's
/Rooms/
/Templates/
/Instrument Presets/

# The website as built (website/build.py), and screenshots as taken (website/tools/screenshots.gd)
website/_site/
website/_shots/

# Which build the app is, written by tools/export.sh while it makes it
game/build_info.gd
game/build_info.gd.uid
